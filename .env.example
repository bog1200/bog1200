# Contact form (src/app/api/contact/route.ts). Copy to .env.local and fill in; never commit real values.

# Discord: channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL. Server-only.
DISCORD_WEBHOOK_URL=

# Cloudflare Turnstile: dashboard -> Turnstile -> Add widget (add your domain).
# The site key is public (it's embedded in the page); the secret key is server-only.
# In development these fall back to Cloudflare's test keys, which always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
